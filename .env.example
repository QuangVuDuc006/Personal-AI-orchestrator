# Copy to .env locally. Keep real values out of Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
CODEX_API_KEY=
WORKSPACE_ROOT=
ARTIFACTS_DIR=_bmad-output/orchestrator

